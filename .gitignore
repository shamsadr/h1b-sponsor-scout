# raw/processed data are large and re-downloadable -- never commit
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
reports/demo/
__pycache__/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
.venv/

# generated scorecards (keep the folder tracked via .gitkeep)
reports/*.csv
!reports/.gitkeep
